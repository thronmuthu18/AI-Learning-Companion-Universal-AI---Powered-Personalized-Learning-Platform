{
  "expo": {
    "name": "AI Learning Companion",
    "slug": "ai-learning-companion",
    "version": "1.0.0",
    "scheme": "ailearningcompanion",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ailearningcompanion.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ailearningcompanion.app",
      "adaptiveIcon": {
        "backgroundColor": "#080D1A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/withExecuTorchNative"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
